generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

/**
 * Platform-level role (separate from workspace MembershipRole).
 * ADMIN = platform ops; CUSTOMER = product user.
 */
enum UserRole {
  ADMIN
  CUSTOMER
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum DeviceStatus {
  QR_READY
  CONNECTED
}

enum OutboundKind {
  TEXT
  TEMPLATE
}

enum OutboundStatus {
  QUEUED
  SENT
  FAILED
  SIMULATED
}

enum ContactStatus {
  VERIFIED
  UNVERIFIED
  INVALID
}

enum BulkCampaignStatus {
  SCHEDULED
  COMPLETED
  FAILED
  PENDING
  RUNNING
  PAUSED
}

enum BulkCampaignRecipientStatus {
  PENDING
  QUEUED
  SENDING
  SENT
  FAILED
  SIMULATED
  SKIPPED
  CANCELED
}

enum BulkSelectionMode {
  GROUPS
  ALL_VERIFIED
  MANUAL
}

enum BulkDeviceMode {
  SINGLE
  FAILOVER
  ROUND_ROBIN
}

enum BulkUniquenessMode {
  NONE
  CAMPAIGN
  WORKSPACE_WINDOW
}

enum AutoReplyTriggerType {
  /**
   * Whole-word match (word boundaries).
   */
  KEYWORD
  EXACT
  CONTAINS
  STARTS_WITH
  ENDS_WITH
  REGEX
}

enum AutoReplyMessageMode {
  TEXT
  TEMPLATE
  MEDIA
}

enum CallResponderCallType {
  RECEIVED
  OUTGOING
  MISSED
  REJECTED
}

enum CallResponderMessageMode {
  TEXT
  TEMPLATE
}

enum BulkScheduleType {
  IMMEDIATE
  SCHEDULED
}

enum ChatbotFlowNodeKind {
  MESSAGE
  QUESTION
  ACTION
  CONDITION
}

enum LiveChatMessageDirection {
  INBOUND
  OUTBOUND
}

enum LiveChatContentKind {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  LOCATION
  CONTACT
  UNKNOWN
}

enum AiProvider {
  GEMINI
  OPENROUTER
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  /**
   * Null when the user only signs in with Google OAuth.
   */
  passwordHash        String?
  /**
   * Google OAuth subject (`sub`); stable per Google account.
   */
  googleId            String?              @unique
  name                String?
  phone               String?
  /**
   * Platform role — not workspace membership.
   */
  role                UserRole             @default(CUSTOMER)
  /**
   * When set, the user cannot sign in or refresh sessions.
   */
  blockedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  memberships         Membership[]
  notifications       Notification[]
}

model RefreshToken {
  id          String    @id @default(uuid())
  hashedToken String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  hashedToken String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Workspace {
  id                     String                  @id @default(uuid())
  name                   String
  slug                   String                  @unique
  plan                   Plan                    @default(FREE)
  stripeCustomerId       String?                 @unique
  stripeSubscriptionId   String?                 @unique
  /**
   * Last checkout provider used for a paid period (stripe | sslcommerz); helps reset/downgrade rules.
   */
  lastPaymentGateway     String?
  subscriptionStatus     String?
  currentPeriodEnd       DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  memberships            Membership[]
  paymentTransactions    PaymentTransaction[]
  devices                Device[]
  messageTemplates       MessageTemplate[]
  templateMediaAssets    TemplateMediaAsset[]
  outboundMessages       OutboundMessage[]
  contactGroups          ContactGroup[]
  bulkCampaigns          BulkCampaign[]
  bulkCampaignRecipients BulkCampaignRecipient[]
  autoReplyRules         AutoReplyRule[]
  callResponderRules     CallResponderRule[]
  chatbotFlows           ChatbotFlow[]
  liveChatThreads        LiveChatThread[]
  aiCredentials          AiCredential[]
  apiCredentials         ApiCredential[]
  notifications          Notification[]
}

/**
 * Workspace-scoped Open API credentials (client_id + client_secret).
 * Raw secret is shown once at creation; only the hash is stored.
 */
model ApiCredential {
  id                 String     @id @default(uuid())
  workspaceId        String
  workspace          Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String
  clientId           String     @unique
  clientSecretHash   String
  clientSecretPrefix String
  active             Boolean    @default(true)
  lastUsedAt         DateTime?
  revokedAt          DateTime?
  createdByUserId    String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([workspaceId])
  @@index([clientId])
}

/**
 * Tracks hosted checkouts (SSLCommerz, future gateways) before confirmation.
 */
model PaymentTransaction {
  id          String    @id @default(uuid())
  gateway     String
  tranId      String    @unique @map("tran_id")
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planId      String
  amount      Decimal   @db.Decimal(12, 2)
  currency    String
  status      String
  sessionKey  String?   @map("session_key")
  valId       String?   @map("val_id")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@map("payment_transactions")
}

model Device {
  id                     String                  @id @default(uuid())
  workspaceId            String
  workspace              Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                   String
  sessionId              String                  @unique
  status                 DeviceStatus            @default(QR_READY)
  phone                  String?
  profilePictureUrl      String?
  /** Workspace default device used by Open API single send when deviceId is omitted. */
  isDefault              Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  outboundMessages       OutboundMessage[]
  bulkCampaignRecipients BulkCampaignRecipient[]
  autoReplyRules         AutoReplyRule[]
  callResponderRules     CallResponderRule[]
  chatbotFlows           ChatbotFlow[]
  liveChatThreads        LiveChatThread[]

  @@index([workspaceId])
  @@index([workspaceId, isDefault])
}

model ChatbotFlow {
  id                String            @id @default(uuid())
  workspaceId       String
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deviceId          String
  device            Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name              String
  description       String            @default("")
  triggerKeywords   String
  cooldownMinutes   Int               @default(0)
  active            Boolean           @default(true)
  conversationCount Int               @default(0)
  aiEnabled         Boolean           @default(false)
  /**
   * AI settings: credentialId, model, systemPrompt?, temperature?, maxTokens?
   */
  aiSettings        Json?
  nodes             ChatbotFlowNode[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([workspaceId])
  @@index([deviceId])
}

model AiCredential {
  id          String     @id @default(uuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  provider    AiProvider
  apiKey      String
  /**
   * Catalog model id or provider model string (validated against allowlist).
   */
  model       String
  /**
   * OpenAI-compatible API base URL (e.g. https://openrouter.ai/api/v1). Null uses provider default.
   */
  apiEndpoint String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model ChatbotFlowNode {
  id        String              @id @default(uuid())
  flowId    String
  flow      ChatbotFlow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  sortOrder Int                 @default(0)
  name      String
  kind      ChatbotFlowNodeKind
  payload   Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([flowId])
}

model LiveChatThread {
  id            String            @id @default(uuid())
  workspaceId   String
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deviceId      String
  device        Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  peerPhone     String
  peerLabel     String            @default("")
  lastPreview   String            @default("")
  lastMessageAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  messages      LiveChatMessage[]

  @@unique([workspaceId, deviceId, peerPhone])
  @@index([workspaceId, deviceId])
}

model LiveChatMessage {
  id                String                   @id @default(uuid())
  threadId          String
  thread            LiveChatThread           @relation(fields: [threadId], references: [id], onDelete: Cascade)
  direction         LiveChatMessageDirection
  kind              LiveChatContentKind      @default(TEXT)
  bodyText          String                   @db.Text
  mediaAssetId      String?
  mediaAsset        TemplateMediaAsset?      @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  mimeType          String?
  fileName          String?
  meta              Json?
  outboundMessageId String?                  @unique
  outboundMessage   OutboundMessage?         @relation(fields: [outboundMessageId], references: [id], onDelete: SetNull)
  createdAt         DateTime                 @default(now())

  @@index([threadId, createdAt])
  @@index([mediaAssetId])
}

model AutoReplyRule {
  id              String               @id @default(uuid())
  workspaceId     String
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deviceId        String
  device          Device               @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name            String
  /**
   * One or more triggers (comma / newline / ; / | separated). Semantics depend on triggerType.
   */
  keyword         String               @db.Text
  triggerType     AutoReplyTriggerType @default(CONTAINS)
  caseSensitive   Boolean              @default(false)
  priority        Int                  @default(100)
  cooldownMinutes Int                  @default(0)
  messageMode     AutoReplyMessageMode @default(TEXT)
  templateId      String?
  template        MessageTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  mediaAssetId    String?
  mediaAsset      TemplateMediaAsset?  @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  mediaCaption    String?              @db.Text
  response        String               @db.Text
  openAiEnabled   Boolean              @default(false)
  /**
   * Preferred: credentialId + model (+ systemPrompt, temperature, maxTokens, continuousChat).
   * Legacy: apiKey + model + baseUrl (+ same optionals).
   */
  openAiSettings  Json?
  active          Boolean              @default(true)
  responseCount   Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([workspaceId])
  @@index([deviceId])
  @@index([mediaAssetId])
}

model CallResponderRule {
  id                   String                   @id @default(uuid())
  workspaceId          String
  workspace            Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deviceId             String
  device               Device                   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name                 String
  callTypes            CallResponderCallType[]
  responseDelayMinutes Int                      @default(0)
  messageMode          CallResponderMessageMode @default(TEXT)
  messageBody          String?                  @db.Text
  templateId           String?
  template             MessageTemplate?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  active               Boolean                  @default(true)
  responsesSent        Int                      @default(0)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([workspaceId])
  @@index([deviceId])
  @@index([templateId])
}

model MessageTemplate {
  id                 String              @id @default(uuid())
  workspaceId        String
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String
  waTemplateName     String
  language           String              @default("en")
  body               String?
  category           String              @default("general")
  typeId             String              @default("text_message")
  footer             String?
  buttons            Json?
  /**
   * Type-specific payload: file refs, URLs, location, poll, list rows, etc.
   */
  media              Json?
  /**
   * When false, hidden from send/campaign pickers; existing automations may still reference the id.
   */
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  outboundMessages   OutboundMessage[]
  bulkCampaigns      BulkCampaign[]
  autoReplyRules     AutoReplyRule[]
  callResponderRules CallResponderRule[]

  @@unique([workspaceId, waTemplateName])
  @@index([workspaceId])
}

model TemplateMediaAsset {
  id               String            @id @default(uuid())
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /**
   * Stored file name on disk (basename only, under workspace folder).
   */
  fileName         String
  mimeType         String
  originalName     String
  byteSize         Int
  createdAt        DateTime          @default(now())
  bulkCampaigns    BulkCampaign[]
  autoReplyRules   AutoReplyRule[]
  liveChatMessages LiveChatMessage[]

  @@index([workspaceId])
}

model BulkCampaign {
  id                 String                  @id @default(uuid())
  workspaceId        String
  workspace          Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String
  kind               OutboundKind
  bodyText           String?
  /**
   * Final message content pool for TEXT campaigns (custom + AI rewrites).
   * bodyText is kept in sync with bodyTexts[0] for preview/compat.
   */
  bodyTexts          Json?
  templateId         String?
  template           MessageTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  deviceIds          Json
  selectionMode      BulkSelectionMode
  groupIds           Json?
  recipientPhones    Json
  recipientCount     Int                     @default(0)
  attachmentType     String?
  attachmentAssetId  String?
  attachmentAsset    TemplateMediaAsset?     @relation(fields: [attachmentAssetId], references: [id], onDelete: SetNull)
  scheduleType       BulkScheduleType
  scheduledAt        DateTime?
  timezone           String?
  /**
   * How multiple selected devices share the load.
   */
  deviceMode         BulkDeviceMode          @default(ROUND_ROBIN)
  /**
   * Random delay between sends: lower bound (seconds). Server enforces minimum 12s when bridge sends.
   */
  delayMinSec        Int                     @default(12)
  /**
   * Random delay between sends: upper bound (seconds).
   */
  delayMaxSec        Int                     @default(45)
  maxRetries         Int                     @default(3)
  antiBlockEnabled   Boolean                 @default(false)
  spintaxEnabled     Boolean                 @default(false)
  verifyNumbers      Boolean                 @default(false)
  repliedOnly        Boolean                 @default(false)
  recent24hOnly      Boolean                 @default(false)
  uniquenessMode     BulkUniquenessMode      @default(NONE)
  batchPauseEvery    Int                     @default(30)
  batchPauseSec      Int                     @default(30)
  failLimitInRow     Int                     @default(5)
  activeHoursStart   String?
  activeHoursEnd     String?
  inactiveHoursStart String?
  inactiveHoursEnd   String?
  status             BulkCampaignStatus      @default(SCHEDULED)
  outboundMessages   OutboundMessage[]
  recipients         BulkCampaignRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([createdAt])
  @@index([attachmentAssetId])
}

model BulkCampaignRecipient {
  id                 String                      @id @default(uuid())
  workspaceId        String
  workspace          Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId         String
  campaign           BulkCampaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  phone              String
  contactId          String?
  groupId            String?
  deviceId           String?
  device             Device?                     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  status             BulkCampaignRecipientStatus @default(PENDING)
  attempts           Int                         @default(0)
  lastError          String?
  queuedAt           DateTime?
  sentAt             DateTime?
  deliveredAt        DateTime?
  seenAt             DateTime?
  repliedAt          DateTime?
  lastReplyAt        DateTime?
  lastReplyText      String?                     @db.Text
  lastReplyMessageId String?
  failedAt           DateTime?
  skippedAt          DateTime?
  canceledAt         DateTime?
  outboundMessageId  String?                     @unique
  outboundMessage    OutboundMessage?            @relation(fields: [outboundMessageId], references: [id], onDelete: SetNull)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@unique([campaignId, phone])
  @@index([workspaceId])
  @@index([campaignId, status])
  @@index([deviceId])
  @@index([outboundMessageId])
  @@index([workspaceId, phone, sentAt])
  @@index([campaignId, repliedAt])
}

model OutboundMessage {
  id              String                 @id @default(uuid())
  workspaceId     String
  workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deviceId        String
  device          Device                 @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  toPhone         String
  kind            OutboundKind
  bodyText        String?
  templateId      String?
  template        MessageTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  bulkCampaignId  String?
  bulkCampaign    BulkCampaign?          @relation(fields: [bulkCampaignId], references: [id], onDelete: SetNull)
  status          OutboundStatus         @default(QUEUED)
  providerRef     String?
  errorMessage    String?
  createdAt       DateTime               @default(now())
  liveChatMessage LiveChatMessage?
  bulkRecipient   BulkCampaignRecipient?

  @@index([workspaceId])
  @@index([deviceId])
  @@index([createdAt])
  @@index([bulkCampaignId])
}

model ContactGroup {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  contacts    Contact[]

  @@index([workspaceId])
}

model Contact {
  id        String        @id @default(uuid())
  groupId   String
  group     ContactGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  status    ContactStatus @default(UNVERIFIED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([groupId, phone])
  @@index([groupId])
}

model StripeEventLog {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
}

model Membership {
  id          String         @id @default(uuid())
  userId      String
  workspaceId String
  role        MembershipRole @default(MEMBER)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

enum NotificationAudience {
  CUSTOMER
  ADMIN
  ALL
}

enum NotificationType {
  CAMPAIGN_COMPLETED
  CAMPAIGN_PAUSED
  CAMPAIGN_FAILED
  DEVICE_DISCONNECTED
  DEVICE_CONNECTED
  SUBSCRIPTION_EXPIRING
  PAYMENT_RECEIVED
  SUBSCRIPTION_CANCELED
  USER_REGISTERED
  SYSTEM_ALERT
}

model Notification {
  id          String               @id @default(uuid())
  audience    NotificationAudience @default(CUSTOMER)
  workspaceId String?              @map("workspace_id")
  workspace   Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?              @map("user_id")
  user        User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String               @db.VarChar(255)
  message     String               @db.Text
  link        String?              @db.VarChar(500)
  isRead      Boolean              @default(false) @map("is_read")
  readAt      DateTime?            @map("read_at")
  metadata    Json?
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@index([workspaceId, audience, isRead])
  @@index([audience, isRead])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

