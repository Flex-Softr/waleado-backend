{
  "name": "flexowhats-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/free-port.cjs 4000 && tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "node scripts/run-prisma.cjs generate",
    "db:migrate": "node scripts/run-prisma.cjs migrate dev",
    "db:push": "node scripts/run-prisma.cjs db push",
    "db:studio": "node scripts/run-prisma.cjs studio",
    "db:seed": "node scripts/run-prisma.cjs db seed",
    "db:deploy": "node scripts/run-prisma.cjs migrate deploy",
    "seed:users": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.41",
    "multer": "^2.1.1",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "stripe": "^17.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.0",
    "prisma": "^6.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
