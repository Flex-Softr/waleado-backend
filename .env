NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:hamim631@localhost:5432/flexowhats?schema=public

# Local dev only — replace in production (openssl rand -base64 48)
JWT_ACCESS_SECRET=flexowhats-local-dev-jwt-secret-min-32-chars-do-not-use-prod

JWT_ACCESS_EXPIRES_IN=1d
REFRESH_TOKEN_DAYS=7

CORS_ORIGIN=http://localhost:3000
COOKIE_SAME_SITE=lax
APP_PUBLIC_URL=http://localhost:3000

# Demo users: npm run db:seed — owner@seed.flexowhats.local / SeedPass12345
