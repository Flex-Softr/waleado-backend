# Backend environment example
# Copy to `.env` for local development, or add these values in your deploy provider.
# Never commit real secrets.

# Runtime / deployment
NODE_ENV=development
PORT=4000
HTTP_JSON_BODY_LIMIT=2mb
# Optional for Dokploy/Nixpacks if it still detects Node 18.
NIXPACKS_NODE_VERSION=20

# Database
# Local Docker Compose:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flexowhats?schema=public
# Docker internal network example:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/flexowhats?schema=public
# Production example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# Auth / sessions
# Generate for production with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=1d
REFRESH_TOKEN_DAYS=7

# URLs / browser security
# Use your deployed frontend URL in production, for example:
# CORS_ORIGIN=https://app.example.com
CORS_ORIGIN=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
# General API rate limiting (defaults: 15 min window, 1000 requests max)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
# Morgan HTTP logger format (default: dev in development, combined in production)
# MORGAN_FORMAT=dev

# Stripe payments (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe price IDs, product IDs, or plain positive amounts such as 29 / 79.
STRIPE_PRICE_PRO_MONTHLY=29
STRIPE_PRICE_BUSINESS_MONTHLY=79
STRIPE_CURRENCY=usd

# SSLCommerz payments (optional)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_PRO_AMOUNT=29.00
SSLCOMMERZ_BUSINESS_AMOUNT=79.00
SSLCOMMERZ_CURRENCY=USD
# Set this when amounts are configured in USD but SSLCommerz should receive BDT.
CONVERSION_RATE_USD_TO_BDT=

# WhatsApp / Baileys
WA_SESSIONS_DIR=./.wa-sessions
WHATSAPP_BRIDGE_ENABLED=true

# Uploads / template media
TEMPLATE_MEDIA_ROOT=./uploads/template-media

# Localization
PHONE_DEFAULT_REGION=US

# Google OAuth (optional)
# Google redirect URI should be:
#   {API_PUBLIC_URL}/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to {API_PUBLIC_URL}/v1/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=

# Password reset email (optional; when unset, local dev logs/returns reset URL)
PASSWORD_RESET_TOKEN_MINUTES=30
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FlexoWhats <no-reply@localhost>
