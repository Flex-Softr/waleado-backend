# Prefer repo root `.env` and/or `.env.local` (see ../.env.example).
# Optional: `server/.env` is still read for any keys not set above (migration-friendly).

# Public URL of this API (SSLCommerz success/fail/cancel + IPN callbacks must reach this host).
# API_PUBLIC_URL=http://localhost:4000

# Google OAuth2 — authorization code flow (/v1/auth/google/start → Google → /v1/auth/google/callback).
# In Google Cloud Console, create OAuth client type “Web application” and add authorized redirect URI:
#   {API_PUBLIC_URL}/v1/auth/google/callback   e.g. http://localhost:4000/v1/auth/google/callback
# APP_PUBLIC_URL must be the Next.js app URL (OAuth completes at /oauth/google/callback).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional override (defaults to {API_PUBLIC_URL}/v1/auth/google/callback):
# GOOGLE_OAUTH_REDIRECT_URI=

# SSLCommerz (sandbox: https://sandbox.sslcommerz.com — use test store from SSLCommerz docs)
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_SANDBOX=true
# SSLCOMMERZ_PRO_AMOUNT=29.00
# SSLCOMMERZ_BUSINESS_AMOUNT=79.00
# SSLCOMMERZ_CURRENCY=USD
